+#include "cog-firebolt-lifecycle.h"
+
+struct _CogFireboltPlatformClass {
+    CogPlatformClass parent_class;
+};
+
+struct _CogFireboltPlatform {
+    CogPlatform parent;
+};
+
+
+extern "C" {
+G_DECLARE_FINAL_TYPE(CogFireboltPlatform, cog_firebolt_platform, COG, HEADLESS_PLATFORM, CogPlatform)
+
+G_DEFINE_DYNAMIC_TYPE_EXTENDED(
+    CogFireboltPlatform,
+    cog_firebolt_platform,
+    COG_TYPE_PLATFORM,
+    0,
+    g_io_extension_point_implement(COG_MODULES_PLATFORM_EXTENSION_POINT, g_define_type_id, "firebolt", 100);)
+}
+
+static void
+cog_firebolt_platform_finalize(GObject *object)
+{
+    G_OBJECT_CLASS(cog_firebolt_platform_parent_class)->finalize(object);
+}
+
+static gboolean
+cog_firebolt_platform_is_supported()
+{
+    return TRUE;
+}
+
+static gboolean
+cog_firebolt_platform_setup(CogPlatform *platform G_GNUC_UNUSED, CogShell *shell G_GNUC_UNUSED, const char *params G_GNUC_UNUSED, GError **error G_GNUC_UNUSED)
+{
+    return ICogFirebolt::Instance().isConnected() ? TRUE : FALSE;
+}
+
+static WebKitWebViewBackend*
+cog_firebolt_platform_get_view_backend(CogPlatform *platform G_GNUC_UNUSED, WebKitWebView *related_view G_GNUC_UNUSED, GError **error G_GNUC_UNUSED)
+{
+    g_info("BUNIO: get view backend");
+    WebKitWebViewBackend *wvb = webkit_web_view_backend_new(wpe_view_backend_create(), NULL, NULL);
+    g_info("BUNIO: get view backend %p",wvb);
+    return wvb;
+}
+
+static void
+cog_firebolt_platform_init_web_view(CogPlatform *platform G_GNUC_UNUSED, WebKitWebView *view G_GNUC_UNUSED)
+{
+    g_info("BUNIO: init view backend %p, %p",platform,view);
+    ICogFirebolt::Instance().createLifecycle(view);
+}
+
+// struct _CogPlatformClass {
