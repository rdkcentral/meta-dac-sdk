+
+//     /*< public >*/
+//     gboolean (*is_supported)(void);
+//     gboolean (*setup)(CogPlatform *, CogShell *shell, const char *params, GError **);
+//     WebKitWebViewBackend *(*get_view_backend)(CogPlatform *, WebKitWebView *related_view, GError **);
+//     void (*init_web_view)(CogPlatform *, WebKitWebView *);
+//     WebKitInputMethodContext *(*create_im_context)(CogPlatform *);
+// };
+
+extern "C" {
+static void
+cog_firebolt_platform_class_init(CogFireboltPlatformClass* klass)
+{
+    GObjectClass* object_class = G_OBJECT_CLASS(klass);
+    object_class->finalize              = cog_firebolt_platform_finalize;
+
+    CogPlatformClass* platform_class = COG_PLATFORM_CLASS(klass);
+    platform_class->is_supported        = cog_firebolt_platform_is_supported;
+    platform_class->setup               = cog_firebolt_platform_setup;
+    platform_class->get_view_backend    = cog_firebolt_platform_get_view_backend;
+    platform_class->init_web_view       = cog_firebolt_platform_init_web_view;
+    platform_class->create_im_context   = NULL;
+}
+
+static void
+cog_firebolt_platform_class_finalize(CogFireboltPlatformClass* klass G_GNUC_UNUSED)
+{
+}
+
+static void
+cog_firebolt_platform_init(CogFireboltPlatform* self)
+{
+}
+
+G_MODULE_EXPORT void
+g_io_cogplatform_firebolt_load(GIOModule* module)
+{
+    GTypeModule* type_module = G_TYPE_MODULE(module);
+    cog_firebolt_platform_register_type(type_module);
+}
+
+G_MODULE_EXPORT void
+g_io_cogplatform_firebolt_unload(GIOModule* module G_GNUC_UNUSED)
+{
+}
