--- /dev/null
+++ cog-0.16.1/platform/firebolt/cog-firebolt-lifecycle.cpp
@@ -0,0 +1,193 @@
+#include "cog-firebolt-lifecycle.h"
+#include <condition_variable>
+#include <mutex>
+#include <glib.h>
+#include "../../core/cog.h"
+#include "wpe/webkit.h"
+#include "FireboltSDK/firebolt.h"
+
+class CogFireboltLifecycle
+{
+    public:
+        CogFireboltLifecycle(WebKitWebView *view);
+        virtual ~CogFireboltLifecycle();
+
+    private:
+        static void         on_close(WebKitWebView *view, CogFireboltLifecycle *cfl);
+        static void         on_notify(WebKitWebView *view, GParamSpec *pspec, CogFireboltLifecycle *cfl);
+        static void         on_message(WebKitWebView *view, WebKitUserMessage *message, CogFireboltLifecycle *cfl);
+
+    private:
+        WebKitWebView      *view;
+};
+
+CogFireboltLifecycle::CogFireboltLifecycle(WebKitWebView *view) :
+    view(view)
+{
+    g_object_ref_sink(view);
+    g_signal_connect(view, "close", G_CALLBACK(on_close), this);
+    g_signal_connect(view, "notify", G_CALLBACK(on_notify), this);
+    g_signal_connect(view, "user-message-received", G_CALLBACK(on_message), this);
+    {
+        GType type = G_TYPE_FROM_INSTANCE(view);
+        guint *signal_ids;
+        guint n_ids;
+        signal_ids = g_signal_list_ids(type, &n_ids);
+
+        g_print("Signal IDs for %s:\n",g_type_name(type));
+        for (guint i = 0; i < n_ids; i++) {
+            guint signal_id = signal_ids[i];
+            GSignalQuery query;
+            g_signal_query(signal_id, &query);
+
+            g_print("  Signal ID: %u, Name: %s\n", signal_id, query.signal_name);
+        }
+
+        g_free(signal_ids);
+    }
+
+    Firebolt::Lifecycle::ILifecycle &lifecycle = Firebolt::IFireboltAccessor::Instance().LifecycleInterface();
+    lifecycle.subscribeOnBackgroundChanged([](const Firebolt::Lifecycle::LifecycleEvent &event) {
+        g_info("BUNIO:%4d:lifecycle / background %d => %d",__LINE__,event.previous,event.state);
+    });
+    lifecycle.subscribeOnForegroundChanged([](const Firebolt::Lifecycle::LifecycleEvent &event) {
+        g_info("BUNIO:%4d:lifecycle / foreground %d => %d",__LINE__,event.previous,event.state);
+    });
+    lifecycle.subscribeOnInactiveChanged([](const Firebolt::Lifecycle::LifecycleEvent &event) {
+        g_info("BUNIO:%4d:lifecycle / inactive %d => %d",__LINE__,event.previous,event.state);
+    });
+    lifecycle.subscribeOnSuspendedChanged([](const Firebolt::Lifecycle::LifecycleEvent &event) {
+        g_info("BUNIO:%4d:lifecycle / suspended %d => %d",__LINE__,event.previous,event.state);
+    });
+    lifecycle.subscribeOnUnloadingChanged([](const Firebolt::Lifecycle::LifecycleEvent &event) {
+        g_info("BUNIO:%4d:lifecycle / onunloading %d => %d",__LINE__,event.previous,event.state);
+    });
+}
+
+CogFireboltLifecycle::~CogFireboltLifecycle()
+{
+    g_object_unref(view);
+}
+
+void CogFireboltLifecycle::on_close(WebKitWebView *, CogFireboltLifecycle *cfl)
+{
+    delete cfl;
+}
+
+void CogFireboltLifecycle::on_notify(WebKitWebView*, GParamSpec* pspec, CogFireboltLifecycle *)
+{
+    g_info("BUNIO:%4d:on_notify \"%s\"",__LINE__,g_param_spec_get_name(pspec));
+}
+
+void CogFireboltLifecycle::on_message(WebKitWebView*, WebKitUserMessage* message, CogFireboltLifecycle *)
+{
+    g_info("BUNIO:%4d:on_message \"%s\"",__LINE__,webkit_user_message_get_name(message));
+}
+
+// ------------------------------------------------------------------------------------------------------------------------------------------------
+
+class CogFirebolt : public ICogFirebolt
+{
+    public:
+        CogFirebolt();
+
+        virtual bool                            createLifecycle(WebKitWebView *view);
+        virtual bool                            isConnected();
+
+    private:
+        bool                                    connect();
+
+    private:
+        std::mutex                              mutex{};
+        std::condition_variable                 cond;
+        bool                                    connected{false};
+        std::unique_ptr<CogFireboltLifecycle>   lifecycle;
+};
+
+CogFirebolt::CogFirebolt()
+{
+    std::srand(std::time({}));
+    connect();
+}
+
+bool CogFirebolt::isConnected()
+{
+    std::unique_lock<std::mutex> lock(mutex);
+    return connected;
+}
+
+static const std::string uriCustomize(const std::string &base, const std::string &appId = "com.rdk.wpe")
+{
+    char buf[256] = { 0 };
+    std::string host = base.substr(0, base.find('?'));
+    snprintf(buf, sizeof(buf), "%s?appId=%s&session=%u-%u", host.c_str(), appId.c_str(), std::time({}), std::rand());
+    return std::string(buf);
+}
+
+static inline const char *fallbackString(const char *env, const char *fallback)
+{
+    return ( env && *env ) ? env : fallback;
+}
+
+bool CogFirebolt::connect()
+{
+    g_info("BUNIO:%4d: firebolt connect",__LINE__);
+    std::unique_lock<std::mutex> lock(mutex);
+    std::string url = uriCustomize(fallbackString(std::getenv("FIREBOLT_ENDPOINT"), "ws://localhost:3474"));
+    const std::string config = "{\
+        \"waitTime\": 1000,\
+        \"logLevel\": \"Debug\",\
+        \"workerPool\":{\
+            \"queueSize\": 8,\
+            \"threadCount\": 3\
+        },\
+        \"wsUrl\": \"" + url + "\"\
+    }";
+    g_info("BUNIO:%4d: firebolt initialize",__LINE__);
+    Firebolt::Error fbError = Firebolt::IFireboltAccessor::Instance().Initialize(config);
+    if (Firebolt::Error::None != fbError)
+    {
+        g_info("BUNIO:%4d: firebolt initialize fail",__LINE__);
+        return false;
+    }
+    g_info("BUNIO:%4d: firebolt connect, %s",__LINE__,url.c_str());
+    fbError = Firebolt::IFireboltAccessor::Instance().Connect([this](const bool _connected, const Firebolt::Error _error){
+        g_info("BUNIO:%4d: firebolt connect state change %d %d",__LINE__,connected,_error);
+        std::unique_lock<std::mutex> lock(mutex);
+        connected = _connected;
+        cond.notify_one();
+        g_info("BUNIO:%4d: firebolt connect state change done",__LINE__);
+    });
+    if (Firebolt::Error::None != fbError)
+    {
+        return false;
+    }
+    g_info("BUNIO:%4d: firebolt connect wait",__LINE__);
+    if (!cond.wait_for(lock, std::chrono::seconds{1}, [this]() { return connected; }))
+    {
+        g_info("BUNIO:%4d: firebolt connect fail %d",__LINE__,connected);
+        return false;
+    }
+    g_info("BUNIO:%4d: firebolt connect success",__LINE__);
+    return true;
+}
+
+bool CogFirebolt::createLifecycle(WebKitWebView *view)
+{
+    std::unique_lock<std::mutex> lock(mutex);
+    if (connected)
+    {
+        if (!lifecycle)
+        {
+            lifecycle = std::make_unique<CogFireboltLifecycle>(view);
+        }
+    }
+    return lifecycle != nullptr;
+}
+
+ICogFirebolt &ICogFirebolt::Instance()
+{
+    static CogFirebolt instance;
+    return instance;
+}
+
